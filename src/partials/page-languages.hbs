<div class="page-languages">
    <button class="languages-menu-toggle" title="Show other languages of this page">{{#if (eq env.SITE_LANG "kmr")}}Kurmancî{{else}}English{{/if}}</button>
    <div class="languages-menu">
        <a class="language{{#if (eq env.SITE_LANG "en")}} is-current{{/if}}" href="{{siteRootPath}}/../en{{page.url}}">English</a>
        <a class="language{{#if (eq env.SITE_LANG "kmr")}} is-current{{/if}}" href="{{siteRootPath}}/../kmr{{page.url}}">Kurmancî</a>
    </div>
</div>
